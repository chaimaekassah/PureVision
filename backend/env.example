# Copier vers .env et compléter



# PostgreSQL

DB_HOST=localhost

DB_PORT=5432

DB_USER=postgres

DB_PASSWORD=password

DB_NAME=testdb



# JWT

JWT_SECRET=change_me



# ─── Catalogue 100 % MinIO (sans TMDB) ───

# 1) docker compose up (MinIO sur :9000, buckets créés par minio-init)

# 2) Uploader tes fichiers dans movies-bucket (posters/, backdrops/)

# 3) Importer database_movies.sql (ou adapter les URLs pour tes clés d’objets)

# Tu n’as pas besoin de TMDB ni de lancer npm run seed:movies.



# TMDB — uniquement si tu utilises npm run seed:movies (script optionnel resyncMovies.mjs)

# https://www.themoviedb.org/settings/api

# TMDB_API_KEY=



# MinIO — utilisé par resyncMovies.mjs si tu l’exécutes ; sinon utile comme référence d’URL (MINIO_PUBLIC_URL)

MINIO_ENDPOINT=localhost

MINIO_PORT=9000

MINIO_USE_SSL=false

MINIO_ACCESS_KEY=admin

MINIO_SECRET_KEY=admin123

MINIO_BUCKET=movies-bucket

MINIO_PUBLIC_URL=http://localhost:9000





# MINIO_SKIP=1  → réservé à seed:movies : pas d’upload MinIO, URLs image.tmdb.org (nécessite TMDB)


